# Used by docker-compose.yml. Copy to .env and replace every changeme.
# Generate secrets with:  openssl rand -base64 32
POSTGRES_PASSWORD=changeme
SECRET_KEY=changeme
NEXTAUTH_SECRET=changeme

# Optional: without GROQ_API_KEY digests fall back to plain article lists,
# without SENDGRID_API_KEY the e-mail channel is disabled.
GROQ_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
