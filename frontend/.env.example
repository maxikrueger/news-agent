# Backend API URL
# Example: http://localhost:8000 (development) or https://api.example.com (production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Configuration
# REQUIRED: Base URL of the frontend application
NEXTAUTH_URL=http://localhost:3000

# REQUIRED: Generate with: openssl rand -base64 32
# This secret is used to encrypt auth tokens and session data
# Must be set in Vercel project environment variables
NEXTAUTH_SECRET=
