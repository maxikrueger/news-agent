# Copy to backend/.env for running the API outside Docker.
# Required (the app refuses to start without them):
DATABASE_URL=postgresql://USER:PASS@localhost:5432/newsagent
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme

# Comma-separated origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:3000

# Optional integrations
GROQ_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional: audio digest. Needs PODCAST_ENABLED=true AND a Google Cloud
# service-account JSON with the Text-to-Speech API enabled. Without both,
# the text digest is delivered as usual and no audio is produced.
PODCAST_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
# Google Cloud WaveNet voices and speaking rate (defaults shown)
PODCAST_LANGUAGE_CODE=de-DE
PODCAST_VOICE_HOST=de-DE-Wavenet-B
PODCAST_VOICE_GUEST=de-DE-Wavenet-A
PODCAST_SPEAKING_RATE=1.05

ENVIRONMENT=development
